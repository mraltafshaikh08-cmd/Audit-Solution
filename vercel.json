{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/widget.js",
      "destination": "/widget.js"
    },
    {
      "source": "/((?!api|widget.js).*)",
      "destination": "/index.html"
    }
  ]
}
